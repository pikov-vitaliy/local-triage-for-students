# Настройки демо-ВМ (/opt/local-triage/.env). Строки TRUSTED_HOSTS и POSTGRES_PASSWORD пишет start.sh.
# Адрес Ollama и модель по умолчанию берутся отсюда только для новой базы; у демо-базы они уже сохранены
# и меняются на странице «Настройки».
# TRIAGE_BIND – где опубликован порт приложения. По умолчанию только 127.0.0.1 ВМ: интерфейс без входа по паролю,
# открывается через SSH-туннель (docs/vm-image.md, «Доступ к приложению»). Адрес ВМ или 0.0.0.0 – только вместе
# с ограничением источника в цепочке DOCKER-USER и до загрузки настоящей выгрузки.
# POSTGRES_PASSWORD – пароль основной базы: случайный, создаётся при первой загрузке копии. Здесь его нет,
# перед выпуском образа cleanup.sh убирает его вместе с томом базы.
# TRIAGE_DB_IMAGE – образ базы по тегу: build.sh загружает его архивом, дайджест после docker load может не сохраниться.
TRIAGE_IMAGE=local-triage:0.2.0
OLLAMA_IMAGE=local-triage-ollama-cpu:0.40.4
TRIAGE_DB_IMAGE=postgres:17.9-alpine
TRIAGE_PORT=8765
TRIAGE_BIND=127.0.0.1
REPOS_ROOT=/srv/repos
REPOS_ROOT_HOST=/srv/repos
OLLAMA_URL=http://ollama:11434
DEFAULT_MODEL=@SMALL_MODEL@
MODEL_NUM_CTX=16384
MEM_LIMIT=3g
DB_MEM_LIMIT=1g
TRUSTED_HOSTS=local-triage-demo
