# Настройки запуска «Локального триажа». Руками этот файл править не нужно: start.ps1 при первом запуске сам создаёт
# из него .env – папку для клонов репозиториев (repos в корне диска с папкой приложения, например D:/repos) и порт
# 8765. Другая папка:
#   .\start.ps1 -ReposRoot D:/work/repos
# Адрес Ollama, модель по умолчанию, статусы Hub и порог срочности SCA меняются в приложении, страница «Настройки».

# Папка для клонов репозиториев на этом компьютере, в контейнер подключается только для чтения. Весь диск
# подключать не нужно. Папка с клонами каждого проекта выбирается внутри неё на странице проекта. Путь – с прямыми
# слэшами.
# Значение ниже – только демо-репозитории (так будет при запуске docker compose без start.ps1).
# Клоны и выгрузки из Hub держите вне папки этого репозитория: рабочие данные не должны попасть в git.
REPOS_ROOT=./examples/demo/repos

# Пароль основной базы PostgreSQL (сервис db в docker-compose.yml). start.ps1 при первом запуске создаёт случайный;
# менять после создания базы нельзя: том базы хранит прежний.
POSTGRES_PASSWORD=

# Порт интерфейса на 127.0.0.1
TRIAGE_PORT=8765
# Доступ к интерфейсу из локальной сети (например, из ВМ VMware): адрес IPv4 этого компьютера. Пусто – только этот
# компьютер. Ставит и убирает start.ps1 (-LanAddress 192.0.2.10 / -LocalOnly). Входа по паролю нет.
TRIAGE_LAN_ADDR=

# Начальные значения настроек – только для самого первого запуска, когда базы приложения ещё нет. Дальше они
# хранятся в базе и меняются на странице «Настройки».
# Адрес Ollama: внутри контейнера 127.0.0.1 – это сам контейнер, Ollama этого компьютера видна как
# host.docker.internal. Разрешены только хосты localhost, 127.0.0.1, ::1, host.docker.internal и ollama.
OLLAMA_URL=http://host.docker.internal:11434
# Модель по умолчанию (выбрана замером, docs/model-benchmark.md); загрузка в Ollama: ollama pull gpt-oss:20b
DEFAULT_MODEL=gpt-oss:20b
# Срочные SCA – с CVSS не ниже этого значения (Severity у SCA в отчёте Hub – уровень политики, а не тяжесть)
SCA_URGENT_CVSS=9.0
# Статусы Hub по итогам разбора, JSON (обычно их меняют в приложении). Значения по умолчанию:
# HUB_STATUS_MAP='{"true_positive": "Подтверждено", "false_positive": "Ложное срабатывание", "uncertain": "Не подтверждено", "risk_accepted": "Риск принят"}'

# Предел размера загружаемой выгрузки, МБ. Больше 100 – увеличьте и TMP_SIZE.
MAX_UPLOAD_MB=50

# Окно контекста модели, токенов (от 4096). Четверть окна, но не больше 3072, оставляется под ответ модели.
MODEL_NUM_CTX=16384
# Схема JSON: retry – только повтор, always – каждый запрос, off – поведение 0.7.0.
# Пусто – DEFAULT_MODEL_JSON_SCHEMA из app/config.py (сейчас always).
MODEL_JSON_SCHEMA=

# Точный запрос OSV (POST /v1/query: экосистема, имя, версия компонента) перед исследованием компонентов внешним
# профилем; ответ – в первом сообщении модели (ADR-0112). Пусто – https://api.osv.dev; off – не запрашивать по новым
# согласиям (согласие с записанным адресом продолжает его использовать, пока не выдано новое).
OSV_URL=

# Пределы контейнера: память и временная папка в памяти, куда попадает загружаемая выгрузка
# MEM_LIMIT=4g
# TMP_SIZE=128m
